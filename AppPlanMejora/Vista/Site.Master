<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="AppPlanMejora.Vista.Site" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SENA - Gestión de Planes de Mejoramiento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body { display: flex; min-height: 100vh; background-color: #f8f9fa; margin: 0; }
        #sidebar { width: 280px; background: #39A900; color: white; min-height: 100vh; box-shadow: 2px 0 5px rgba(0,0,0,0.1); }
        .nav-link { color: rgba(255,255,255,0.9) !important; font-weight: 500; transition: all 0.2s; }
        .nav-link:hover { background: rgba(255,255,255,0.15); color: #fff !important; border-radius: 5px; }
        .nav-link i { font-size: 1.1rem; }
        .content { flex-grow: 1; padding: 30px; overflow-y: auto; }
        hr { border-top: 1px solid rgba(255,255,255,0.3); }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div id="sidebar" class="d-flex flex-column p-3">
            <a href="#" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                <i class="bi bi-mortarboard-fill me-2 fs-3"></i>
                <span class="fs-4 fw-bold">PlanMejora SENA</span>
            </a>
            <hr />
            
            <ul class="nav nav-pills flex-column mb-auto gap-1">
                
                <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                    <li class="nav-item">
                        <a href="Programa.aspx" class="nav-link"><i class="bi bi-book me-2"></i> Programas</a>
                    </li>
                    <li>
                        <a href="Ficha.aspx" class="nav-link"><i class="bi bi-collection me-2"></i> Fichas</a>
                    </li>
                    <li>
                        <a href="Instructor.aspx" class="nav-link"><i class="bi bi-person-badge me-2"></i> Instructores</a>
                    </li>
                </asp:PlaceHolder>

                <asp:PlaceHolder ID="phInstructor" runat="server" Visible="false">
                    <li>
                        <a href="PlanMejoramiento.aspx" class="nav-link"><i class="bi bi-file-earmark-text me-2"></i> Mis Planes</a>
                    </li>
                </asp:PlaceHolder>

                <asp:PlaceHolder ID="phEstudiante" runat="server" Visible="false">
                    <li>
                        <a href="MisActividades.aspx" class="nav-link"><i class="bi bi-card-checklist me-2"></i> Mis Evidencias</a>
                    </li>
                    <li>
                        <a href="ConsultarPlan.aspx" class="nav-link"><i class="bi bi-search me-2"></i> Consultar Estado</a>
                    </li>
                </asp:PlaceHolder>

                <hr />
                <li>
                    <a href="Perfil.aspx" class="nav-link"><i class="bi bi-person-circle me-2"></i> Mi Perfil</a>
                </li>
            </ul>
            
            <hr />
            <div class="dropdown">
                <asp:LinkButton ID="btnCerrarSesion" runat="server" OnClick="btnCerrarSesion_Click" CssClass="btn btn-danger w-100 btn-sm fw-bold">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                </asp:LinkButton>
            </div>
        </div>

        <main class="content">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
        </main>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>